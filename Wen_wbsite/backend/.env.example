# 服务端口
PORT=3000
HOST="0.0.0.0"

# 数据库路径（Prisma SQLite）
DATABASE_URL="file:./data/app.db"

# Manticore Search HTTP 接口及实时索引名称
MANTICORE_HTTP_URL="http://127.0.0.1:9308"
MANTICORE_TIMEOUT_MS="5000"
MANTICORE_LIBRARY_INDEX="wenxin_library"
MANTICORE_COMMUNITY_INDEX="wenxin_community"

# 阿里云短信认证服务（Dypnsapi）
ALIBABA_CLOUD_ACCESS_KEY_ID=""
ALIBABA_CLOUD_ACCESS_KEY_SECRET=""
ALIYUN_DYPN_REGION_ID="cn-hangzhou"
ALIYUN_DYPN_ENDPOINT="dypnsapi.aliyuncs.com"
ALIYUN_SMS_SIGN_NAME=""
# 必须填写阿里云控制台中已审核通过的实际“模板 Code”（不是模板名称）。
# 默认系统模板 100001 使用 code、min 两个模板变量。
ALIYUN_SMS_TEMPLATE_CODE=""
ALIYUN_SMS_SCHEME_NAME=""

# JWT 双令牌（必须使用两段不同的高强度随机值）
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
JWT_ISSUER="wenxin-api"
JWT_AUDIENCE="wenxin-web"

# Refresh Cookie；本地 HTTP 开发设为 false，生产 HTTPS 必须设为 true
AUTH_COOKIE_SECURE="false"
AUTH_COOKIE_DOMAIN=""

# 逗号分隔的前端来源；生产环境必须设置
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"
TRUST_PROXY="false"

# DeepSeek API 配置
DEEPSEEK_API_URL="https://api.deepseek.com/chat/completions"
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_MODEL="deepseek-chat"
# 可选：单独指定翻译模型，未设置时使用 DEEPSEEK_MODEL
DEEPSEEK_TRANSLATE_MODEL="deepseek-chat"
# 当前项目固定使用非思考模式（代码会在每次请求中发送 thinking.type=disabled）

# AI Mock 模式
# 设为 true 可在不启动 Ollama 的情况下测试前后端联调
# 设为 false 或删除此行以使用真实 AI 服务
AI_MOCK_MODE="false"
