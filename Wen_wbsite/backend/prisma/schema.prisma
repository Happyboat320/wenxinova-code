// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// 书籍表
model Book {
  id             Int      @id @default(autoincrement())
  title          String
  author         String
  dynasty        String?  // 年代（唐、宋等）
  description    String?
  image          String?
  category       String?  // 题材体裁（传奇、话本等）
  theme          String?  // 主题
  mainCharacters String?  // 主要人物
  keywords       String?  // 关键词
  annotationCount Int?    // 注释数目
  originalText   String?  // 原文内容
  translatedText String?  // 译文内容
  summary        String?  // 摘要/梗概
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // 关联
  characters Character[]
  annotations Annotation[]
  creations   Creation[]
  knowledgeGraph BookKnowledgeGraph?
}

// 由 LLM 生成并复用的书籍知识图谱，JSON 以文本保存以兼容 SQLite。
model BookKnowledgeGraph {
  id               Int      @id @default(autoincrement())
  bookId           Int      @unique
  timelineJson     String
  relationshipJson String
  generatedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

// 角色表（剧本杀角色）
model Character {
  id          Int      @id @default(autoincrement())
  bookId      Int
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关联
  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)
}

model Annotation {
  id        Int      @id @default(autoincrement())
  bookId    Int
  index     Int
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  book Book @relation(fields: [bookId], references: [id], onDelete: Cascade)

  @@unique([bookId, index])
}

// 用户表
model User {
  id              Int              @id @default(autoincrement())
  phone           String           @unique
  nickname        String?
  signature       String?
  avatar          String?
  passwordHash    String?
  phoneVerifiedAt DateTime?
  status          String           @default("active")
  role            String           @default("user") // user/admin
  creations       Creation[]
  creationLikes   CreationLike[]
  comments        CreationComment[]
  adminApplications AdminApplication[] @relation("AdminApplicant")
  reviewedAdminApplications AdminApplication[] @relation("AdminApplicationReviewer")
  reviewedCreations Creation[] @relation("CreationReviewer")
  refreshSessions RefreshSession[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// 普通用户申请管理员；审核备注同时记录通过或驳回理由。
model AdminApplication {
  id         Int       @id @default(autoincrement())
  userId     Int
  remark     String
  status     String    @default("pending") // pending/approved/rejected
  reviewNote String?
  reviewerId Int?
  reviewedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user     User  @relation("AdminApplicant", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User? @relation("AdminApplicationReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

// Refresh Token 会话；数据库中只保存令牌哈希
model RefreshSession {
  id           String    @id
  userId       Int
  tokenHash    String    @unique
  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?
  userAgent    String?
  ipAddress    String?
  createdAt    DateTime  @default(now())
  lastUsedAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

// 创作记录表
model Creation {
  id          Int       @id @default(autoincrement())
  userId      Int
  bookId      Int?
  category    String    @default("other") // 社区分类：adaptation/script/props/dm/other
  status      String    @default("draft") // draft/pending/published/rejected
  prompt      String    // 提示词
  content     String    // 生成的内容
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt
  publishedAt DateTime?
  submittedAt DateTime?
  reviewedAt  DateTime?
  reviewedById Int?
  reviewNote  String?

  // 关联
  user User @relation(fields: [userId], references: [id])
  book Book? @relation(fields: [bookId], references: [id])
  likes CreationLike[]
  comments CreationComment[]
  reviewedBy User? @relation("CreationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([status, category, publishedAt])
  @@index([userId, status, updatedAt])
  @@index([status, submittedAt])
}

// 社区点赞：每位用户对同一篇已发布作品最多点赞一次。
model CreationLike {
  userId     Int
  creationId Int
  createdAt  DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creation Creation @relation(fields: [creationId], references: [id], onDelete: Cascade)

  @@id([userId, creationId])
  @@index([creationId, createdAt])
}

// 社区评论
model CreationComment {
  id         Int      @id @default(autoincrement())
  userId     Int
  creationId Int
  content    String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  creation Creation @relation(fields: [creationId], references: [id], onDelete: Cascade)

  @@index([creationId, createdAt])
  @@index([userId, createdAt])
}
