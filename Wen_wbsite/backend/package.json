{
  "name": "wenxin-backend",
  "version": "1.0.0",
  "description": "文心新述 - 古典小说智能改编平台后端",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "import:excel": "tsx scripts/import-excel.ts",
    "import:text": "tsx scripts/import-text.ts",
    "import:json": "tsx scripts/import-json.ts",
    "import:all": "prisma migrate deploy && tsx scripts/import-all.ts",
    "import:collections": "prisma migrate deploy && tsx scripts/import-collections.ts",
    "process:taohuashan": "tsx scripts/process-taohuashan-annotations.ts",
    "dedupe:taohuashan-annotations": "tsx scripts/dedupe-taohuashan-annotations.ts",
    "dedupe:taohuashan-stage": "tsx scripts/dedupe-taohuashan-stage-directions.ts",
    "split:linchuan": "tsx scripts/split-linchuan.ts",
    "search:reindex": "tsx scripts/reindex-search.ts",
    "test:deepseek-translation": "tsx test_api/run-translation-benchmark.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [
    "nodejs",
    "express",
    "prisma",
    "sqlite",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "packageManager": "pnpm@11.14.0",
  "dependencies": {
    "@alicloud/dypnsapi20170525": "^2.0.0",
    "@alicloud/openapi-core": "^1.0.8",
    "@darabonba/typescript": "^1.0.5",
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "jsonwebtoken": "^9.0.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.19.10",
    "@types/supertest": "^6.0.2",
    "prisma": "^6.19.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
